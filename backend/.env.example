# Скопировать в .env и загрузить параметры командой из README.
# Файл .env исключён из Git.

# Ключ для подписи данных Django. Сгенерировать командой из README.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Можно оставить пустым: браузер обращается к API через Vite.
CSRF_TRUSTED_ORIGINS=

# Локальная база PostgreSQL. Для Homebrew имя пользователя по умолчанию
# совпадает с именем пользователя macOS, DB_USER можно оставить пустым.
DB_NAME=brier
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
