# Шаблон файла с настройками окружения.
# Скопировать в .env и заполнить своими значениями:
#     cp .env.example .env
# Сам .env в репозиторий не попадает — он перечислен в .gitignore.

# Секретный ключ Django. Используется для подписи сессионных кук.
# Для каждого окружения свой, генерируется случайно.
SECRET_KEY=

# Режим отладки. На своём компьютере True, на сервере обязательно False:
# при True Django показывает посетителю трассировку ошибки с кусками кода.
DEBUG=True

# Домены, с которых разрешено обслуживать запросы.
# Через запятую, без пробелов.
ALLOWED_HOSTS=127.0.0.1,localhost

# Адреса, которым доверяется проверка CSRF-токена.
# На сервере сюда прописывается поддомен с https://
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Подключение к PostgreSQL
DB_NAME=brier
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
