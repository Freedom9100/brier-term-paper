# --- Секреты ---
# Пароль от базы, SECRET_KEY Django, адрес сервера.
# В репозиторий не попадает никогда. Рядом лежит .env.example
# с теми же ключами, но пустыми значениями.
.env
.env.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# Виртуальное окружение: у каждого своё, ставится из requirements.txt
venv/
.venv/
env/

# --- Django ---
# Файл базы SQLite. Проект работает на PostgreSQL, но файл может
# появиться при экспериментах и в репозитории он не нужен.
db.sqlite3
db.sqlite3-journal

# Результат сборки статики командой collectstatic — генерируется,
# не пишется руками.
staticfiles/
/backend/static_collected/

# Загруженные пользователями файлы: это данные, а не код.
media/

*.log

# --- Машинное обучение ---
# Обученная модель — результат работы скрипта train_model.py.
# Каждое переобучение меняет файл целиком, и git хранил бы
# новую копию при каждом коммите. Модель заново создаётся командой.
*.joblib

# --- Frontend ---
# Скачанные библиотеки: восстанавливаются командой npm install
# по файлу package-lock.json, который в репозитории лежит.
node_modules/

# Собранный фронтенд: генерируется командой npm run build
dist/
.vite/

npm-debug.log*

# --- macOS ---
# Служебный файл Finder с настройками отображения папки.
.DS_Store

# --- Редакторы ---
.vscode/
.idea/
*.swp

# --- Claude Code ---
# Личные настройки прав доступа, у каждого свои.
# Сами правила и навыки проекта (.claude/rules, .claude/skills)
# в репозиторий попадают — они часть проекта.
.claude/settings.local.json

# Локальная среда и база для защиты.
/.demo-local/
